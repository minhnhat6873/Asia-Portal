PORT=4000
DATABASE=
NODE_ENV=development
# Các origin frontend được phép gọi API, ngăn cách bằng dấu phẩy.
# Không dùng * vì API đang dùng cookie xác thực.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Tương thích cấu hình cũ, chỉ dùng nếu CORS_ALLOWED_ORIGINS chưa được khai báo.
DOMAIN_FRONTEND=http://localhost:3000
# 100 request / 15 phút / IP cho toàn API; login/register chỉ 5 lần / 15 phút / IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
# Chỉ đặt 1 khi deploy sau một reverse proxy đáng tin cậy (Nginx, Render, Railway...).
TRUST_PROXY_HOPS=
JWT_SECRET=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary: ch? c?u h?nh ? backend, kh?ng ??a API secret sang frontend.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
