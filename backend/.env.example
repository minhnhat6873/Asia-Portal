PORT=4000
DATABASE=
NODE_ENV=development
AUTH_COOKIE_SECURE=false
# Các origin frontend được phép gọi API, ngăn cách bằng dấu phẩy.
# Không dùng * vì API đang dùng cookie xác thực.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Tương thích cấu hình cũ, chỉ dùng nếu CORS_ALLOWED_ORIGINS chưa được khai báo.
DOMAIN_FRONTEND=http://localhost:3000
# API public: 300 request / 15 phút / IP. API quản trị: 600 request / 15 phút / tài khoản.
# Login/register: 5 lần / 15 phút / IP. Refresh: 60 lần / 15 phút / IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=5
AUTHENTICATED_RATE_LIMIT_MAX=600
REFRESH_RATE_LIMIT_MAX=60
# Chỉ đặt 1 khi deploy sau một reverse proxy đáng tin cậy (Nginx, Render, Railway...).
TRUST_PROXY_HOPS=
JWT_SECRET=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_ROLE=admin
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary: ch? c?u h?nh ? backend, kh?ng ??a API secret sang frontend.
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
