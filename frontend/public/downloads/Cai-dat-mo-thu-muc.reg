Windows Registry Editor Version 5.00

; Asia Portal - open the fixed company shared-documents folder.
; Target: \\192.168.16.10\data\Chung
; This registers the shortcut for the current Windows user.
; The URL is intentionally NOT passed to Explorer (no %1 argument).

[HKEY_CURRENT_USER\Software\Classes\asia-folder]
@="URL:Asia Portal Shared Documents"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\asia-folder\shell\open\command]
