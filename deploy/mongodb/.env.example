# Sao chép thành deploy/mongodb/.env trên server. File .env không được commit.
# Dùng `openssl rand -hex 24` để tạo mật khẩu: chỉ có chữ và số nên không cần URL-encode.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=
# Tên database đang dùng trên Atlas, lấy từ đường dẫn trong DATABASE của backend/.env.
APP_DB_NAME=
APP_DB_PASSWORD=
